    "Tap any day to add a prayer you prayed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر أي يوم لإضافة صلاة أديتها."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk hari mana pun untuk menambah salat yang Anda tunaikan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kıldığınız bir namazı eklemek için herhangi bir güne dokunun."
          }
        }
      }
    },
    "Tap the bookmark icon on any ayah to save it here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر أيقونة الحفظ على أي آية لحفظها هنا."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk ikon penanda pada ayat mana pun untuk menyimpannya di sini."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ayeti buraya kaydetmek için yer imi simgesine dokunun."
          }
        }
      }
    },
    "Tap the circle to count" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر الدائرة للعدّ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk lingkaran untuk menghitung"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saymak için daireye dokunun"
          }
        }
      }
    },
    "Tap the dot to show or hide a tab. The first %lld appear in the bar — any extras move into a “More” tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر النقطة لإظهار تبويب أو إخفائه. تظهر أول %lld في الشريط — وأي زيادة تنتقل إلى تبويب «المزيد»."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk titik untuk menampilkan atau menyembunyikan tab. %lld pertama muncul di bilah — selebihnya pindah ke tab “Lainnya”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sekmeyi göstermek veya gizlemek için noktaya dokunun. İlk %lld sekme çubukta görünür — fazlası “Daha Fazla” sekmesine taşınır."
          }
        }
      }
    },
    "tap three times" : {
