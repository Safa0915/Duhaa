        }
      }
    },
    "Choose a visual theme for this player" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مظهرًا بصريًا لهذا المشغّل"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tema visual untuk pemutar ini"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu oynatıcı için görsel bir tema seçin"
          }
        }
      }
    },
    "Choose how Duhaa looks on your home screen. Each option keeps the same crescent-and-stars mark in a different palette." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر كيف يبدو ضحى على شاشتك الرئيسية. يحتفظ كل خيار بعلامة الهلال والنجوم نفسها بلون مختلف."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tampilan Duhaa di layar utama Anda. Setiap pilihan mempertahankan lambang bulan sabit dan bintang yang sama dalam palet berbeda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duhaa’nın ana ekranınızda nasıl görüneceğini seçin. Her seçenek aynı hilal-yıldız işaretini farklı bir palette taşır."
          }
        }
      }
    },
    "Choose Manually" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاختيار يدويًا"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih Manual"
