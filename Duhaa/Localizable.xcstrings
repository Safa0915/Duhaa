    "“Your Lord has not forsaken you, nor does He despise you.” — Ad-Duhaa" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ﴾ — الضحى"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tuhanmu tidak meninggalkanmu dan tidak (pula) membencimu.” — Ad-Duha"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Rabbin seni bırakmadı ve sana darılmadı.” — Duhâ"
          }
        }
      }
    },
