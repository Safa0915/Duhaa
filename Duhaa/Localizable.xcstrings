      }
    },
    "Only include what you're comfortable sending by email." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدرج فقط ما ترتاح لإرساله بالبريد الإلكتروني."
