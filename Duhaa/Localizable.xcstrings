    "Warm dusk over quiet dunes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غسق دافئ على كثبان هادئة"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senja hangat di atas bukit pasir yang sunyi"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessiz kumullar üzerinde sıcak alacakaranlık"
          }
        }
      }
    },
    "Website (optional)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقع الإلكتروني (اختياري)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situs web (opsional)"
