    "It is Sunnah to count dhikr on your fingers. Source: Abu Dawud, hadith 1502." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من السنة عدّ الذكر بالأصابع. المصدر: أبو داود، حديث 1502."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghitung zikir dengan jari adalah Sunnah. Sumber: Abu Dawud, hadis 1502."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zikri parmaklarla saymak sünnettir. Kaynak: Ebû Dâvûd, hadis 1502."
          }
        }
      }
    },
    "It removes Duhaa's local preferences, prayer marks, Quran bookmarks, tab layout, opening, and onboarding flag from UserDefaults." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل تفضيلات ضحى المحلية وعلامات الصلاة ومحفوظات القرآن وترتيب التبويبات والافتتاحية وعلامة التهيئة من UserDefaults."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menghapus preferensi lokal Duhaa, tanda salat, penanda Al-Qur'an, tata letak tab, pembuka, dan penanda pengenalan dari UserDefaults."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duhaa’nın yerel tercihlerini, namaz işaretlerini, Kur’an yer imlerini, sekme düzenini, açılışı ve karşılama kaydını UserDefaults’tan kaldırır."
