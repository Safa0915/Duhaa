    "Changing this recomputes prayer times immediately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير هذا يعيد حساب أوقات الصلاة فورًا."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengubah ini menghitung ulang waktu salat seketika."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu değiştirmek namaz vakitlerini hemen yeniden hesaplar."
          }
        }
      }
    },
    "Changing this reschedules upcoming prayer notifications immediately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير هذا يعيد جدولة تنبيهات الصلاة القادمة فورًا."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengubah ini menjadwalkan ulang notifikasi salat berikutnya seketika."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu değiştirmek yaklaşan namaz bildirimlerini hemen yeniden planlar."
          }
        }
      }
    },
    "Check off the prayers you completed on this day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علّم الصلوات التي أديتها في هذا اليوم."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Centang salat yang Anda tunaikan pada hari ini."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu gün kıldığınız namazları işaretleyin."
          }
        }
      }
    },
    "Chinese Blossom" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الزهر الصيني"
