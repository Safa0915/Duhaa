    "%lld local Duhaa keys are ready to export. The file stays on this device until you share or save it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld عنصرًا محليًا في ضحى جاهز للتصدير. يبقى الملف على هذا الجهاز حتى تشاركه أو تحفظه."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld data lokal Duhaa siap diekspor. Berkas tetap di perangkat ini sampai Anda membagikan atau menyimpannya."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld yerel Duhaa kaydı dışa aktarılmaya hazır. Dosya, siz paylaşana veya kaydedene kadar bu cihazda kalır."
          }
        }
      }
