    "Can't find them? Ask us to add them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تجدهم؟ اطلب منا إضافتهم."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak menemukannya? Minta kami menambahkannya."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulamadınız mı? Eklememizi isteyin."
          }
        }
      }
    },
    "Can't find your mosque?" : {
      "localizations" : {
        "ar" : {
