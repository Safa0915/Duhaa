    "High latitude caution. Verify Fajr and Isha with a trusted local mosque and adjust times if needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنبيه خطوط العرض العالية. تحقّق من الفجر والعشاء مع مسجد محلي موثوق وعدّل الأوقات عند الحاجة."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringatan lintang tinggi. Pastikan Subuh dan Isya dengan masjid setempat yang tepercaya dan sesuaikan waktu bila perlu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek enlem uyarısı. Sabah ve Yatsı’yı güvendiğiniz yerel bir cami ile doğrulayın ve gerekirse vakitleri ayarlayın."
          }
