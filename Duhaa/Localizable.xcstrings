    "Days to make up, e.g. from Ramadan. Set how many you owe, then check them off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيام القضاء، مثلًا من رمضان. حدّد عدد ما عليك، ثم علّمها واحدًا واحدًا."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari untuk diqada, mis. dari Ramadan. Tetapkan berapa yang Anda tanggung, lalu centang satu per satu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaza edilecek günler, ör. Ramazan’dan. Kaç gün borcunuz olduğunu belirleyin, sonra tek tek işaretleyin."
          }
        }
      }
    },
