    "Shown in place of Dhuhr on Fridays." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعرض بدل الظهر أيام الجمعة."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditampilkan menggantikan Zuhur pada hari Jumat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuma günleri Öğle yerine gösterilir."
          }
        }
      }
    },
    "Shows how many prayers you've kept on time, prayed late, or missed in your Journey — a gentle nudge to grow. Turning it on starts fresh from today." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُظهر كم صلاة أديتها في وقتها أو متأخرًا أو فاتتك في رحلتك — تشجيع لطيف على النمو. تفعيله يبدأ من جديد اليوم."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunjukkan berapa salat yang Anda tunaikan tepat waktu, terlambat, atau terlewat dalam Perjalanan Anda — dorongan lembut untuk tumbuh. Mengaktifkannya dimulai dari awal hari ini."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
