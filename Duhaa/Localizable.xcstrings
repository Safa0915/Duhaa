    "At this latitude, dawn and night can be approximate. Compare with a trusted local mosque and adjust times if needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند هذا العرض الجغرافي قد يكون الفجر والليل تقريبيين. قارن مع مسجد محلي موثوق وعدّل الأوقات عند الحاجة."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada lintang ini, fajar dan malam bisa hanya perkiraan. Bandingkan dengan masjid setempat yang tepercaya dan sesuaikan waktu bila perlu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu enlemde imsak ve yatsı yaklaşık olabilir. Güvendiğiniz yerel bir cami ile karşılaştırın ve gerekirse vakitleri ayarlayın."
          }
        }
      }
    },
