    "Hanafi calculates Asr later, when an object's shadow is twice its length." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسب المذهب الحنفي العصر متأخرًا، حين يصير ظل الشيء ضعف طوله."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mazhab Hanafi menghitung Asar lebih lambat, saat bayangan benda dua kali panjangnya."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanefi mezhebi İkindi’yi daha geç, bir cismin gölgesi boyunun iki katı olduğunda hesaplar."
          }
        }
      }
    },
    "He is nearer to you than your jugular vein." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وهو أقرب إليك من حبل الوريد."
