    "Sound plays your selected notification sound · Silent shows a banner only · Off sends nothing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«صوت» يشغّل صوت التنبيه المختار · «صامت» يعرض لافتة فقط · «إيقاف» لا يرسل شيئًا."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara memutar suara notifikasi pilihan Anda · Senyap hanya menampilkan spanduk · Mati tidak mengirim apa pun."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli, seçtiğiniz bildirim sesini çalar · Sessiz yalnızca başlık gösterir · Kapalı hiçbir şey göndermez."
          }
        }
      }
    },
    "Sound uses the bundled Duhaa chime or the default iOS alert. Full adhan recordings will only appear once licensed audio is bundled." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم الصوت نغمة ضحى المضمّنة أو تنبيه iOS الافتراضي. لن تظهر تسجيلات الأذان الكاملة إلا بعد تضمين صوت مرخّص."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara memakai nada Duhaa bawaan atau peringatan iOS standar. Rekaman azan penuh hanya muncul setelah audio berlisensi disertakan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses, uygulamayla gelen Duhaa zilini veya varsayılan iOS uyarısını kullanır. Tam ezan kayıtları ancak lisanslı ses eklendiğinde sunulacaktır."
          }
        }
      }
