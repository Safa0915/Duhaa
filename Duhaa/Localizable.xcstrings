    "Built on hope, never guilt — a gentle return to prayer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مبني على الأمل لا الذنب — عودة لطيفة إلى الصلاة."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibangun atas harapan, bukan rasa bersalah — kembali kepada salat dengan lembut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suçluluk değil, umut üzerine kurulu — namaza nazik bir dönüş."
          }
        }
      }
    },
