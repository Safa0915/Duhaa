        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biru Langit dan Merah Muda memakai palet siang yang cerah. Merah Muda adalah pratinjau premium gratis — tanpa langganan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gök Mavisi ve Açık Pembe aydınlık gündüz paletleri kullanır. Açık Pembe ücretsiz bir premium önizlemedir — abonelik gerekmez."
          }
        }
