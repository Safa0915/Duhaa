        }
      }
    },
    "Your Lord has not forsaken you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما ودّعك ربك وما قلى."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuhanmu tidak meninggalkanmu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rabbin seni bırakmadı."
          }
        }
      }
    },
    "Your manual timetable replaces calculated adhan times everywhere, including notifications and widgets." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحل جدولك اليدوي محل أوقات الأذان المحسوبة في كل مكان، بما في ذلك التنبيهات والأدوات."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jadwal manual Anda menggantikan waktu azan yang dihitung di mana saja, termasuk notifikasi dan widget."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuel takviminiz; bildirimler ve widget’lar dâhil her yerde hesaplanan ezan vakitlerinin yerini alır."
          }
        }
