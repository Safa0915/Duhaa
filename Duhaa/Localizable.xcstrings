          }
        }
      }
    },
    "Choose the sound used when a prayer notification plays." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الصوت المستخدم عند تشغيل تنبيه الصلاة."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih suara yang dipakai saat notifikasi salat berbunyi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namaz bildirimi geldiğinde çalınacak sesi seçin."
          }
        }
      }
    },
    "Choose what shows under each ayah. At least one stays on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما يظهر تحت كل آية. يبقى واحد على الأقل مفعّلًا."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apa yang tampil di bawah tiap ayat. Setidaknya satu tetap aktif."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ayetin altında nelerin görüneceğini seçin. En az biri açık kalır."
          }
        }
      }
    },
    "Choose whether the home banner leads with the next prayer name or the time remaining until it begins." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كانت لافتة الشاشة الرئيسية تعرض اسم الصلاة التالية أم الوقت المتبقي حتى تبدأ."
          }
        },
        "id" : {
