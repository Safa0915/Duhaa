            "state" : "translated",
            "value" : "تعذّر تحميل خطط الدعم الآن. يرجى التحقق من اتصالك والمحاولة بعد قليل."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket dukungan tidak dapat dimuat saat ini. Silakan periksa koneksi Anda dan coba lagi sebentar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destek planları şu anda yüklenemedi. Lütfen bağlantınızı kontrol edip birazdan yeniden deneyin."
          }
        }
      }
    },
