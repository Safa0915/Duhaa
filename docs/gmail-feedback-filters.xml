  <entry>
    <category term='filter'/>
    <title>Mail Filter</title>
    <id>tag:mail.google.com,2008:filter:duhaa-feedback-all</id>
    <updated>2026-06-25T16:00:00Z</updated>
    <content/>
    <apps:property name='hasTheWord' value='to:duhaaapp@gmail.com ("Duhaa Feedback" OR "Duhaa Bug Report" OR "Duhaa Du&apos;a Request" OR "Duhaa Feedback Metadata")'/>
    <apps:property name='label' value='Feedback'/>
  </entry>

