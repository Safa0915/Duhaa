# Node (prayer-verify harness)
node_modules/

# macOS
.DS_Store

# Xcode — user-specific state & build artifacts
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
build/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
#   Keep shared Package.resolved tracked (reproducible builds);
#   it lives under xcshareddata/swiftpm and is NOT matched below.
.swiftpm/
.build/

# Audio masters / large media (recitation, adhan files) — keep out of repo.
# Ship-ready compressed audio can be force-added intentionally (git add -f).
*.wav
*.aiff
*.flac

# Env / secrets / signing
.env
.env.*
*.pem
*.p8
*.p12
*.mobileprovision

# Logs
*.log

# IDE
.idea/
.vscode/
